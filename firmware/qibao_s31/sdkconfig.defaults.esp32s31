CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y


CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

# 屏幕方向：注意**不要**开 CONFIG_LV_USE_MATRIX / CONFIG_LV_DRAW_TRANSFORM_USE_MATRIX。
# 开了之后 LVGL 走「矩阵」那条变换路径，但本项目用的是纯软件渲染器（LV_DRAW_SW），
# 它根本不消费绘制任务的矩阵，画面根本不会跟着转（实测：校验和不变）。
# 对象级变换（transform_rotation）在矩阵关闭时走的才是软件渲染器支持的那条路。

# 板型：这块板是 ESP32-S31-Korvo-1，音频 codec 是 ES8389。
# 必须显式锁定，否则 Kconfig 默认会选 FUNCTION_COREBOARD_1（ES8311），
# 启动时写 ES8311 I2C 寄存器失败 -> ESP_ERR_NOT_ALLOWED -> 无限重启。
CONFIG_BOARD_TYPE_ESP32_S31_KORVO_1=y
# CONFIG_BOARD_TYPE_ESP32_S31_FUNCTION_COREBOARD_1 is not set

# 七宝妹妹：自定义唤醒词（MultiNet，S31 原生支持，拼音空格分隔）
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="qi bao mei mei"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="七宝妹妹"
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20
# S31 只支持 MULTINET7（mn6 仅限 S3），自定义唤醒词必须选一个 multinet 模型
CONFIG_SR_MN_CN_MULTINET7_QUANT=y

# 分区表：标准 v2/16m.csv 的 app 只有 4MB，本固件含人脸识别模型达 7.2MB，
# 改用大 app 分区表（ota_0 7.875MB + assets 8MB），烧录地址不变。
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m_qibao.csv"

