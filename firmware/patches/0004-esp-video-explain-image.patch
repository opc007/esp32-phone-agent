 #endif  // CONFIG_XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE
@@ -773,6 +773,12 @@ bool EspVideo::Capture() {
         }
     }
 
+    // 实时小窗自己画。这里再做一张半屏静帧会把 UYVY 转成另一块大图，
+    // 失败时还会让本来已经抓到的帧变成 Capture() 失败。
+    if (!preview_on_capture_) {
+        return frame_.data != nullptr;
+    }
+
     // 显示预览图片
     auto display = Board::GetInstance().GetDisplay();
     if (display != nullptr) {
@@ -1130,3 +1136,20 @@ std::expected<std::string, std::string> EspVideo::Explain(const std::string& que
         (int)frame_.len, (int)total_sent, (int)remain_stack_size, question.c_str(), result.c_str());
     return result;
 }
+
+std::expected<std::string, std::string> EspVideo::ExplainImage(
+    const uint8_t* data, size_t len, uint16_t width, uint16_t height, v4l2_pix_fmt_t format,
+    const std::string& question) {
+    if (data == nullptr || len == 0 || width == 0 || height == 0) {
+        return std::unexpected("没有画面");
+    }
+    FrameBuffer saved = frame_;
+    frame_.data = const_cast<uint8_t*>(data);
+    frame_.len = len;
+    frame_.width = width;
+    frame_.height = height;
+    frame_.format = format;
+    auto result = Explain(question);
+    frame_ = saved;
+    return result;
+}
