diff --git a/sdkconfig.defaults.esp32s31 b/sdkconfig.defaults.esp32s31
index db45394..7cab050 100644
--- a/sdkconfig.defaults.esp32s31
+++ b/sdkconfig.defaults.esp32s31
@@ -25,3 +25,42 @@ CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536
 # LVGL Graphics
 CONFIG_LV_USE_SNAPSHOT=y
 
+# 屏幕方向：**不要**开 LVGL 矩阵旋转。
+# 矩阵那条路（LV_DRAW_TRANSFORM_USE_MATRIX）会把变换写进 layer->matrix -> task->matrix，
+# 纯软件渲染器（LV_DRAW_SW）根本不消费，画面纹丝不动（实测送显缓冲校验和前后完全一样）。
+# 现在用的是「容器级对象变换」：lv_obj_set_style_transform_rotation()，
+# LVGL 会把对象画进独立图层再带角度贴回，纯软件渲染器支持，触摸逆变换也是 LVGL 自带的。
+# 这几项必须保持关闭（板级 Kconfig 也是关的）。
+# CONFIG_LV_USE_MATRIX is not set
+# CONFIG_LV_DRAW_TRANSFORM_USE_MATRIX is not set
+
+# 板型：这块板是 ESP32-S31-Korvo-1，音频 codec 是 ES8389。
+# 必须显式锁定，否则 Kconfig 默认会选 FUNCTION_COREBOARD_1（ES8311），
+# 启动时写 ES8311 I2C 寄存器失败 -> ESP_ERR_NOT_ALLOWED -> 无限重启。
+CONFIG_BOARD_TYPE_ESP32_S31_KORVO_1=y
+# CONFIG_BOARD_TYPE_ESP32_S31_FUNCTION_COREBOARD_1 is not set
+
+# 七宝妹妹：自定义唤醒词（MultiNet，S31 原生支持，拼音空格分隔）
+CONFIG_USE_CUSTOM_WAKE_WORD=y
+CONFIG_CUSTOM_WAKE_WORD="qi bao mei mei"
+CONFIG_CUSTOM_WAKE_WORD_DISPLAY="七宝妹妹"
+CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20
+# S31 只支持 MULTINET7（mn6 仅限 S3），自定义唤醒词必须选一个 multinet 模型
+CONFIG_SR_MN_CN_MULTINET7_QUANT=y
+
+# 分区表：标准 v2/16m.csv 的 app 只有 4MB，本固件含人脸识别模型达 7.2MB，
+# 改用大 app 分区表（ota_0 7.875MB + assets 8MB），烧录地址不变。
+CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m_qibao.csv"
+
+# 摄像头：OV3660（DVP）。
+# 板级 config.json 里的 "sdkconfig_append": ["CONFIG_CAMERA_OV3660=y"] 在本工程的
+# sdkconfig 生成路径上**不生效**（本工程用 sdkconfig.defaults + sdkconfig.defaults.esp32s31
+# 两个 defaults 文件生成），所以必须显式写在这里。
+# 不写的话传感器驱动不编进固件 -> DVP 驱动绑不上 -> /dev/video2 不存在 -> 摄像头完全用不了。
+CONFIG_CAMERA_OV3660=y
+CONFIG_CAMERA_OV3660_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
+# 输出 JPEG 320x240：人脸识别那侧正好按 320x240 解码，不用再缩放。
+CONFIG_CAMERA_OV3660_DVP_JPEG_320X240_25FPS=y
+CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_JPEG_320X240_25FPS=y
+# EspVideo::Capture() 只有开了这个才把 JPEG 当成合法输入（否则它会把帧当 YUYV 处理）。
+CONFIG_XIAOZHI_CAMERA_ALLOW_JPEG_INPUT=y
