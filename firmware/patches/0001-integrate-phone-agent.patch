+void LcdDisplay::SetLayoutRoot(lv_obj_t* root, int w, int h) {
+    ui_root_ = root;
+    layout_w_ = w;
+    layout_h_ = h;
+}
+
+void LcdDisplay::ClearUIObjects() {
+    // 先停掉会往旧对象上画东西的定时器 / GIF
+    if (preview_timer_ != nullptr) {
+        esp_timer_stop(preview_timer_);
+    }
+    if (gif_controller_ != nullptr) {
+        gif_controller_->Stop();
+    }
+
+    // 删掉旧界面对象（顺序和析构函数一致：先子后父）
+    if (preview_image_ != nullptr) { lv_obj_del(preview_image_); preview_image_ = nullptr; }
+    if (chat_message_label_ != nullptr) { lv_obj_del(chat_message_label_); chat_message_label_ = nullptr; }
+    if (emoji_label_ != nullptr) { lv_obj_del(emoji_label_); emoji_label_ = nullptr; }
+    if (emoji_image_ != nullptr) { lv_obj_del(emoji_image_); emoji_image_ = nullptr; }
+    if (emoji_box_ != nullptr) { lv_obj_del(emoji_box_); emoji_box_ = nullptr; }
+    if (content_ != nullptr) { lv_obj_del(content_); content_ = nullptr; }
+    if (bottom_bar_ != nullptr) { lv_obj_del(bottom_bar_); bottom_bar_ = nullptr; }
+    if (status_bar_ != nullptr) { lv_obj_del(status_bar_); status_bar_ = nullptr; }
+    if (top_bar_ != nullptr) { lv_obj_del(top_bar_); top_bar_ = nullptr; }
+    if (side_bar_ != nullptr) { lv_obj_del(side_bar_); side_bar_ = nullptr; }
+    if (container_ != nullptr) { lv_obj_del(container_); container_ = nullptr; }
+}
+
+void LcdDisplay::RebuildUI() {
+    DisplayLockGuard lock(this);
+    ESP_LOGI(TAG, "重建 UI：布局 %dx%d，根对象 %p", (int)LayoutW(), (int)LayoutH(), (void*)ui_root_);
+
+    ClearUIObjects();
+
+    // 让 SetupUI() 能重新建一遍（它开头有 setup_ui_called_ 的防重复保护）
+    setup_ui_called_ = false;
+    SetupUI();
+}
